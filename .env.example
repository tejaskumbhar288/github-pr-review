# --- LLM backend: "gemini" (default) or "ollama" ---
LLM_PROVIDER=gemini

# Gemini (free tier: https://aistudio.google.com/apikey)
# Models get retired without warning - a retired one returns 404 from
# generateContent while still appearing in the models list. Pinning beats the
# `gemini-flash-latest` alias here, because a model that shifts underneath you
# silently invalidates every eval baseline you have recorded.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Ollama (fully local, no egress)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=16384

# --- GitHub ---
# Optional for public repos, but raises the rate limit 60 -> 5000/hr.
# Needs pull_requests: write to post reviews.
GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# --- GitHub App (webhook mode only) ---
GITHUB_APP_ID=
# Either paste the PEM inline (\n-escaped is fine) or point at the file.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# --- Review budget knobs ---
MAX_FILES=40
MAX_PATCH_LINES=800
MAX_RETRIES=5
# A separate, smaller budget for the model failing to answer at all - a
# truncated response, an empty candidate, a recitation block. Waiting out a rate
# limit is free; re-rolling spends another request from a 20/day free-tier cap,
# so the two must not share one counter.
MAX_SAMPLING_RETRIES=3
# Whole-file context is the biggest quality lever and the biggest token sink.
# Set to 0 to send diffs only.
CONTEXT_CHAR_LIMIT=60000
CONTEXT_CONCURRENCY=8
REQUEST_TIMEOUT=180

# --- Repo-aware context: pull in the callers of a changed function ---
# Off by default as a budget decision, not a quality one: it uses GitHub's code
# search, which is 30 requests/minute across the whole account, so a busy
# webhook install would starve its own queue. `--repo-context` turns it on for a
# single CLI review.
REPO_CONTEXT=false
REPO_CONTEXT_MAX_SYMBOLS=3
REPO_CONTEXT_MAX_FILES=4
REPO_CONTEXT_PER_FILE=3

# --- Publishing ---
# COMMENT never blocks a merge; REQUEST_CHANGES does, and only escalates when
# something critical was found.
REVIEW_EVENT=COMMENT
# Post automatically without the CLI's --post flag. The worker always posts.
POST_REVIEWS=false

# --- Incremental review ---
# On a re-push, review only the commits added since our last review of this PR.
# Falls back to the whole diff whenever that is not safe - no prior review, a
# force-push, a failed compare - so the worst case is the old behaviour.
INCREMENTAL_REVIEW=true

# --- Queue / worker ---
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=reviews
IDEMPOTENCY_TTL=86400
WORKER_CONCURRENCY=2
# Failures allowed per (pr, head_sha) before the job is dead-lettered instead
# of retried. Inspect what landed there with `make dlq`.
MAX_ATTEMPTS=3

# --- Observability (optional; both keys needed to enable) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LOG_LEVEL=INFO

# --- Static analysis pre-pass ---
STATIC_ANALYSIS=true
RUFF_PATH=ruff
SEMGREP_PATH=semgrep
# Not "auto": semgrep refuses that unless metrics are on, and the pre-pass runs
# with --metrics off. Any concrete ruleset works; p/default is the broad one.
SEMGREP_CONFIG=p/default
STATIC_ANALYSIS_TIMEOUT=60
MAX_KNOWN_ISSUES=60
# Drop lint rules that are structurally inapplicable to test code - S101 above
# all, since `assert` is how pytest works. The pre-pass runs isolated from the
# PR's own ruff config, so the ignores every project sets under tests/ are
# invisible to it and those findings arrive at full volume.
SUPPRESS_TEST_NOISE=true
